{
  "VirusTotal": {
    "ApiKey": "",
    "BaseUrl": "https://www.virustotal.com/api/v3",
    "TimeoutSeconds": 30,
    "Enabled": false
  },
  "Etw": {
    "SessionName": "InstallSentinel_ETW",
    "BufferSizeMb": 64,
    "MinBuffers": 64,
    "MaxBuffers": 256,
    "FlushTimer": "00:00:01",
    "KernelProviders": [
      "Microsoft-Windows-Kernel-File",
      "Microsoft-Windows-Kernel-Registry",
      "Microsoft-Windows-Kernel-Process",
      "Microsoft-Windows-Kernel-ImageLoad"
    ]
  },
  "NoiseFilter": {
    "ExcludedPaths": [
      "C:\\Windows\\Temp\\*",
      "C:\\Windows\\Prefetch\\*",
      "C:\\Windows\\Logs\\*",
      "C:\\ProgramData\\Microsoft\\Windows\\WER\\*",
      "C:\\Users\\*\\AppData\\Local\\Temp\\*",
      "C:\\Windows\\System32\\config\\*",
      "C:\\Windows\\System32\\wbem\\*",
      "C:\\Windows\\System32\\wbem\\Repository\\*",
      "C:\\Windows\\System32\\LogFiles\\*",
      "C:\\Windows\\Temp\\*",
      "C:\\$Recycle.Bin\\*",
      "C:\\System Volume Information\\*",
      "C:\\Windows\\Microsoft.NET\\Framework*\\Temporary ASP.NET Files\\*",
      "C:\\Windows\\Microsoft.NET\\Framework64*\\Temporary ASP.NET Files\\*",
      "C:\\Windows\\SoftwareDistribution\\*",
      "C:\\Windows\\WinSxS\\*",
      "C:\\Windows\\servicing\\*"
    ],
    "ExcludedPids": [4, 8],
    "ExcludedProcessNames": [
      "System", "Registry", "smss.exe", "csrss.exe", "wininit.exe",
      "services.exe", "lsass.exe", "svchost.exe", "fontdrvhost.exe",
      "dwm.exe", "SearchIndexer.exe", "MsMpEng.exe", "NisSrv.exe"
    ],
    "ExcludedExtensions": [
      ".tmp", ".temp", ".log", ".etl", ".evt", ".evtx",
      ".wer", ".dmp", ".mdmp", ".hdmp"
    ]
  },
  "Rollback": {
    "OutputDirectory": "C:\\InstallSentinel\\Rollbacks",
    "CreateSystemRestorePoint": true,
    "IncludeRegistryRollback": true,
    "IncludeFileRollback": true,
    "MaxRollbackScripts": 50
  },
  "Ui": {
    "TableRefreshRateMs": 250,
    "MaxTableRows": 200,
    "ShowPidColumn": true,
    "ShowThreadIdColumn": false,
    "EnableColors": true,
    "Theme": "dark"
  }
}